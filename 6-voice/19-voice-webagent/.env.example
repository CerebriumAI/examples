LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

LINKUP_API_KEY=

# Default LLM: LiveKit Inference Gemma (uses LIVEKIT_API_KEY/SECRET above)
# LLM_MODEL=google/gemma-4-31b-it

DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Optional: use deployed SGLang (Qwen3.6 + DFLASH on B200) instead of LiveKit Inference
# LLM_BASE_URL=https://api.cerebrium.ai/v4/p-xxxxxx/sglang-llm/v1
# LLM_MODEL=Qwen/Qwen3.6-35B-A3B
# CEREBRIUM_API_KEY=

# Optional: use OpenAI directly instead of LiveKit Inference
# LLM_MODEL=openai/gpt-4o-mini
# (still billed via LiveKit Inference when using inference.LLM)
